# 无密钥时营养识别和总结不可用；/studio 提供合成示例。不会读取其他项目配置。
PORT=4371
HOST=127.0.0.1
# 阿里云百炼；地址填写纯 URL，不要使用 Markdown 链接。
# 填入 Key 并重启后启用文字饮食识别、日周总结和工程演示工具编排。
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=
LLM_DEFAULT_MODEL_ID=qwen3.5-plus
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_S=60
# 营养首页图片识别使用该视觉模型，共用上面的 Base URL 和 Key。
VLM_DEFAULT_MODEL_ID=qwen3-vl-plus
VLM_TIMEOUT_S=120
# 兼容旧 MODEL_* 命名；只有不存在 LLM_BASE_URL / LLM_API_KEY /
# LLM_DEFAULT_MODEL_ID 时才读取整组 MODEL_*，两组不能混用。
